# Kindr Server Environment Variables
# Copy this file to .env and fill in values

# MongoDB
MONGO_URI=mongodb://localhost:27017/kindr
# For Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/kindr?retryWrites=true&w=majority

# JWT
JWT_SECRET=kindr_jwt_secret_change_me_in_production_2026
JWT_REFRESH_SECRET=kindr_refresh_secret_change_me_in_production_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:8081

# Node
NODE_ENV=development
